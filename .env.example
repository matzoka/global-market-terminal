# Example environment configuration for Global Market Terminal.
# Copy to .env for local Node runs. On Cloudflare Workers, set the same
# variable names as Worker Secrets (or wrangler.jsonc `vars`). Never commit
# real values, and never expose them in browser-side code.

# Free evaluation adapter: Alpaca Basic personal account, with the IEX feed.
# IEX is one exchange, not a full consolidated U.S. market feed. Keep "none"
# until you have created a free personal account and generated credentials.
MARKET_DATA_PROVIDER=none
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional paid/licensed adapter. Twelve Data Basic must not be used to display
# this dashboard unless its current display rights permit it.
TWELVE_DATA_API_KEY=

# Free personal sources used by the index and metals panels. Set these only as
# secrets: EODHD is daily EOD reference data; Metals.Dev is quota cached.
EODHD_API_TOKEN=
METALS_DEV_API_KEY=

# A quote is never called REALTIME unless its exchange entitlement is known.
# Classify every displayed instrument after provider preflight. Unlisted IDs are
# marked UNVERIFIED, never assumed to be delayed or real-time.
# Comma-separated GMT instrument IDs, for example: AAPL,NVDA,MSFT
MARKET_DATA_REALTIME_IDS=
MARKET_DATA_DELAYED_IDS=
MARKET_DATA_EOD_IDS=
QUOTE_CACHE_SECONDS=60

# GMT-UX-05 refresh hardening. A forced (?refresh=1) refresh may bypass provider
# TTLs at most once per this interval, so free-tier quotas are not burned by
# refresh spam. Each provider request is also capped by the deadline below.
FORCE_REFRESH_MIN_INTERVAL_MS=15000
PROVIDER_REFRESH_DEADLINE_MS=12000
